DATABASE_URL=
# Long random string that signs sign-in cookies (openssl rand -hex 32)
SESSION_SECRET=
# Public address of the site, e.g. https://tutor.example.com (Railway sets RAILWAY_PUBLIC_DOMAIN, which also works)
APP_ORIGIN=

# Optional: take card payments through Stripe Checkout
STRIPE_SECRET_KEY=
# Signing secret of the webhook pointed at /api/payment-webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Optional: let anyone create an account without an invite (they get the Family role)
PUBLIC_SIGNUPS_ALLOWED=false

# Optional: bearer token for POST /api/jobs/run (reminders, holds, package expiry)
JOBS_SECRET=

# Optional: email. Without SMTP_HOST messages are logged as skipped
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional: S3-compatible storage for homework and resource files (local disk otherwise)
S3_BUCKET_NAME=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Tests only: a database whose name ends in _test; npm test migrates and fills it
TEST_DATABASE_URL=
