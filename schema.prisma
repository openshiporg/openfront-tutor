model PaymentProvider {
  id                          String           @id @default(cuid())
  profile                     TutorProfile     @relation("PaymentProvider_profile", fields: [profileId], references: [id])
  profileId                   String           @map("profile")
  name                        String           @default("")
  code                        String           @default("")
  isInstalled                 Boolean          @default(true)
  createPaymentFunction       String           @default("manual")
  capturePaymentFunction      String           @default("manual")
  refundPaymentFunction       String           @default("manual")
  getPaymentStatusFunction    String           @default("manual")
  generatePaymentLinkFunction String           @default("manual")
  handleWebhookFunction       String           @default("manual")
  paymentSessions             PaymentSession[] @relation("PaymentSession_paymentProvider")
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @default(now()) @updatedAt

  @@index([profileId])
}

model PaymentSession {
  id                String                   @id @default(cuid())
  profile           TutorProfile             @relation("PaymentSession_profile", fields: [profileId], references: [id])
  profileId         String                   @map("profile")
  target            PaymentSessionTargetType @default(session)
  session           Session?                 @relation("PaymentSession_session", fields: [sessionId], references: [id])
  sessionId         String?                  @map("session")
  purchase          PackagePurchase?         @relation("PaymentSession_purchase", fields: [purchaseId], references: [id])
  purchaseId        String?                  @map("purchase")
  invoice           Invoice?                 @relation("PaymentSession_invoice", fields: [invoiceId], references: [id])
  invoiceId         String?                  @map("invoice")
  paymentProvider   PaymentProvider?         @relation("PaymentSession_paymentProvider", fields: [paymentProviderId], references: [id])
  paymentProviderId String?                  @map("paymentProvider")
  status            PaymentSessionStatusType @default(pending)
  amountCents       Int
  currencyCode      String                   @default("USD")
  providerPaymentId String                   @default("")
  expiresAt         DateTime?
  capturedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @default(now()) @updatedAt

  @@index([profileId])
  @@index([sessionId])
  @@index([purchaseId])
  @@index([invoiceId])
  @@index([paymentProviderId])
  @@index([providerPaymentId])
}

model PaymentWebhookEvent {
  id              String   @id @default(cuid())
  replayKey       String   @unique @default("")
  providerCode    String   @default("")
  providerEventId String   @default("")
  eventType       String   @default("")
  payloadHash     String   @default("")
  processedAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model Expense {
  id          String              @id @default(cuid())
  profile     TutorProfile        @relation("Expense_profile", fields: [profileId], references: [id])
  profileId   String              @map("profile")
  spentOn     DateTime            @default(now())
  category    ExpenseCategoryType @default(other)
  amountCents Int
  note        String              @default("")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt

  @@index([profileId])
}

model NotificationLog {
  id        String                    @id @default(cuid())
  profile   TutorProfile              @relation("NotificationLog_profile", fields: [profileId], references: [id])
  profileId String                    @map("profile")
  kind      String                    @default("")
  to        String                    @default("")
  subject   String                    @default("")
  link      String                    @default("")
  status    NotificationLogStatusType @default(skipped)
  error     String                    @default("")
  session   Session?                  @relation("NotificationLog_session", fields: [sessionId], references: [id])
  sessionId String?                   @map("session")
  invoice   Invoice?                  @relation("NotificationLog_invoice", fields: [invoiceId], references: [id])
  invoiceId String?                   @map("invoice")
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @default(now()) @updatedAt

  @@index([profileId])
  @@index([sessionId])
  @@index([invoiceId])
}

